{
  "name": "hinina",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "plugin:sdk:check": "tsc --strict --noEmit --skipLibCheck --target es2022 --module esnext --moduleResolution bundler doc/modules/src-tauri/plugin/sdk/typecheck.ts doc/modules/src-tauri/plugin/sdk/scaffold/index.ts doc/modules/src-tauri/plugin/sdk/examples/balloon/index.ts doc/modules/src-tauri/plugin/sdk/examples/balloon/__tests__/balloon.spec.ts",
    "plugin:scaffold:build": "node scripts/build-plugin-scaffold.mjs",
    "plugin:balloon:build": "node scripts/build-plugin-scaffold.mjs doc/modules/src-tauri/plugin/sdk/examples/balloon/index.ts src-tauri/target/plugin-balloon.js",
    "release:check": "node scripts/check-release-versions.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@vicons/ionicons5": "^0.12",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "marked-katex-extension": "^5.1.13",
    "monaco-editor": "^0.52",
    "naive-ui": "^2",
    "pinia": "^2",
    "vue": "^3.5",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^5.0.0",
    "vue-tsc": "^2"
  }
}
